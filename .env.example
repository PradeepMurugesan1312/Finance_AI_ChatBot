# Copy to .env for local development. Never commit a real .env file.
# In Cloud Foundry these are set as env vars / service bindings instead (see README, step 7).

ENVIRONMENT=dev
SERVICE_NAME=ahf-finance-assistant
LOG_LEVEL=INFO
PORT=8080

# Externally reachable base URL of this agent, used to build the A2A agent
# card's endpoint URL. Locally this is http://localhost:8080; in Cloud
# Foundry this is the app's route (e.g. https://ahf-agent-dev.cfapps.eu10.hana.ondemand.com).
AGENT_BASE_URL=http://localhost:8080
